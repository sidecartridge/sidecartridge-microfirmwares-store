{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-store.sidecartridge.com/schema/unofficial.schema.json",
  "title": "unofficial.json — per-platform registry of unofficial catalog sources (D-08)",
  "description": "Curated, in-repo list of a platform's unofficial (remote) app catalogs. Each source points at a remote apps.json (same contract as apps.schema.json) that must be HTTPS + CORS (C-04). See docs/epics DECISIONS D-07/D-08.",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "description": "Zero or more unofficial sources. Empty = the platform has only its official catalog.",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "apps_url", "enabled", "author"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "description": "Slug, unique within the platform." },
        "name": { "type": "string", "description": "Catalog display name." },
        "apps_url": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Remote apps.json URL; must be HTTPS + CORS (C-04)." },
        "enabled": { "type": "boolean" },
        "description": { "type": "string" },
        "author": { "$ref": "#/$defs/author" }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "image": { "type": "string", "format": "uri" },
        "contact": { "type": "string" }
      }
    }
  }
}
